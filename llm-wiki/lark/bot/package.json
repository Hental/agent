{
  "name": "lark-long-connection-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "description": "A TypeScript Hono service for Feishu long-connection events and messaging.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rstest run",
    "test:watch": "rstest",
    "cli": "tsx cli/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "dotenv": "17.4.2",
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@rstest/core": "0.11.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
