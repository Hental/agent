    "test:dist": "node --test test-dist/smoke.test.mjs"
  },
  "devDependencies": {
    "@rspack/cli": "^2.2.2",
    "@rspack/core": "^2.2.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
